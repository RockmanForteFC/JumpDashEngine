func _ready():
	$"../../IdleTimer".connect("timeout", self, "go_up")

func _enter():
	$"../../IdleTimer".start()

func _update(delta):
	pass

#-------------------------------------------------
#      Public Methods
#-------------------------------------------------
func go_up():
	#first shot is faster.afterward each other shot is slightly delayed
	$"../../IdleTimer".wait_time = 1.5
	emit_signal("finished", "up")
