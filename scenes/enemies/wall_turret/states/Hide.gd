func _ready():
	$"../../hide_timer".connect("timeout",$"../../AnimationPlayer","play",["Shoot"])

func _enter():
	$"../../hide_timer".start()
	owner.is_blocking = true
	$"../../AnimationPlayer".play("Idle")
