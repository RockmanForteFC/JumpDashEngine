func _ready():
	$"../../HitboxTimer".connect("timeout",self,"disable_collision")

func _enter() -> void:
	$"../../explosion/CollisionShape2D" .set_deferred("disabled", false)
	._enter()
	$"../../HitboxTimer".start()

#-------------------------------------------------
#      Public Methods
#-------------------------------------------------
func disable_collision():
	$"../../explosion/CollisionShape2D" .set_deferred("disabled", true)
