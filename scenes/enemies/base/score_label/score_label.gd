var score:String = "1000"
#-------------------------------------------------
#      Processes
#-------------------------------------------------

func _ready():
	$RichTextLabel.bbcode_text = "[center][rainbow][wave amp=100]" + score + "[/wave][/rainbow][/center]"
	$Tween.interpolate_property(self,"modulate:a",1,0,0.5,Tween.TRANS_CIRC,Tween.EASE_IN_OUT,1.0)
	$Tween.start()
	yield($Tween,"tween_all_completed")
	queue_free()

