func _ready():
	pass

func _enter():
	$"../../AnimationPlayer".play("Idle")
	$"../../wait_time".wait_time = owner.timer
	if $"../../wait_time".wait_time < 1 :
		$"../../wait_time".wait_time = Physics.rng.randf_range(1.0,5.0)
	$"../../wait_time".start()

