func _ready():
	pass

func _enter():
	$"../../AnimationPlayer".play("Idle")
	var wait = owner.timer
	if wait < 1 :
		wait = Physics.rng.randf_range(1.0,5.0)
	$"../../wait_time".wait_time = wait
	$"../../wait_time".start()

func _update(delta):
	pass
