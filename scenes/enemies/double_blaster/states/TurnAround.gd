func _ready():
	pass

func _enter():
	owner.is_direction_locked = true
	get_parent().state = "turn_around"
	$"../../AnimatedSprite".play("Turn")
	owner.face_player()
	yield($"../../AnimatedSprite","animation_finished")
	emit_signal("finished","idle")

