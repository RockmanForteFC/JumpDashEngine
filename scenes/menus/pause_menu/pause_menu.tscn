[sub_resource type="Shader" id=25]
code = "shader_type canvas_item;

uniform float horizontal_speed;
uniform float vertical_speed;

void fragment () {
	COLOR = texture(TEXTURE, vec2(UV.x + TIME * horizontal_speed, UV.y + TIME * vertical_speed));
}"

